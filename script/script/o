#!/usr/bin/env bash
# Open macOS application by fuzzy matching name
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $(basename "$0") <app_name> [args...]"
    exit 1
fi

app_query="$1"
shift

# Search in standard macOS application directories
app=$(find /Applications /System/Applications /System/Applications/Utilities "$HOME/Applications" -maxdepth 2 -type d -iname "*${app_query}*.app" 2>/dev/null | head -n 1)

if [ -n "$app" ]; then
    echo "Opening: $app"
    open -a "$app" "$@"
else
    echo "No application found matching '$app_query'" >&2
    exit 1
fi
