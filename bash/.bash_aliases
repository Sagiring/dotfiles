# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../../'
alias ....='cd ../../../'
alias serve='python -m http.server'

# print current week number
alias week='date +%V'
alias c="code ."
alias bash="/opt/homebrew/bin/bash"
alias python="/opt/homebrew/bin/python3"
alias python3="/opt/homebrew/bin/python3"
